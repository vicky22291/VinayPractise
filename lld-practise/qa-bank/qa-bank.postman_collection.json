{
  "info": {
    "name": "Q&A Bank API",
    "description": "Run top to bottom. 'Create question' stores questionId; 'List page 1' stores nextCursor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "authorId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "voterId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "questionId", "value": "" },
    { "key": "nextCursor", "value": "" }
  ],
  "item": [
    {
      "name": "Create question (201)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Location header', () => pm.response.to.have.header('Location'));",
        "pm.collectionVariables.set('questionId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-User-Id", "value": "{{authorId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"How do I reverse a list in Java?\",\n  \"body\": \"I tried a for loop but it feels clumsy.\"\n}" },
        "url": "{{baseUrl}}/questions"
      }
    },
    {
      "name": "Create second question (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-User-Id", "value": "{{authorId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"What does volatile guarantee in Java?\",\n  \"body\": \"Visibility, ordering, or atomicity?\"\n}" },
        "url": "{{baseUrl}}/questions"
      }
    },
    {
      "name": "List page 1 (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('nextCursor', pm.response.json().nextCursor || '');"
      ]}}],
      "request": { "method": "GET", "url": "{{baseUrl}}/questions?limit=1" }
    },
    {
      "name": "List page 2 with cursor (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/questions?limit=1&cursor={{nextCursor}}" }
    },
    {
      "name": "Get question (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/questions/{{questionId}}" }
    },
    {
      "name": "Upvote (201)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{voterId}}" }],
        "url": "{{baseUrl}}/questions/{{questionId}}/upvotes"
      }
    },
    {
      "name": "Upvote again (409)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{voterId}}" }],
        "url": "{{baseUrl}}/questions/{{questionId}}/upvotes"
      }
    },
    {
      "name": "Author upvotes own question (403)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{authorId}}" }],
        "url": "{{baseUrl}}/questions/{{questionId}}/upvotes"
      }
    },
    {
      "name": "Upvote unknown question (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{voterId}}" }],
        "url": "{{baseUrl}}/questions/00000000-0000-0000-0000-000000000000/upvotes"
      }
    },
    {
      "name": "Create with invalid body (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-User-Id", "value": "{{authorId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"short\",\n  \"body\": \"\"\n}" },
        "url": "{{baseUrl}}/questions"
      }
    },
    {
      "name": "Create without X-User-Id (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"A valid title for this one\",\n  \"body\": \"x\"\n}" },
        "url": "{{baseUrl}}/questions"
      }
    },
    {
      "name": "List with limit over max (400)",
      "request": { "method": "GET", "url": "{{baseUrl}}/questions?limit=500" }
    },
    {
      "name": "List with bad cursor (400)",
      "request": { "method": "GET", "url": "{{baseUrl}}/questions?cursor=garbage" }
    }
  ]
}
