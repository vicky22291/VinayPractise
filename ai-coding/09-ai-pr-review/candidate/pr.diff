-"""Invoice totals. All amounts are integers in cents."""
+"""Invoice totals. Supports every currency in invoicing.currency.SUPPORTED."""
+import logging
 from collections import defaultdict
 from decimal import ROUND_HALF_UP, Decimal
 
+log = logging.getLogger(__name__)
+
 
 def subtotal(lines):
     return sum(line.unit_amount * line.quantity for line in lines)
@@ -18,5 +21,17 @@ def tax(lines):
     return total
 
 
-def invoice_total(lines):
-    return subtotal(lines) + tax(lines)
+def line_total(line):
+    """Amount for one line including its tax, in major units."""
+    amount = line.unit_amount / 100 * line.quantity
+    return round(amount * (1 + float(line.tax_rate)), 2)
+
+
+def invoice_total(lines, currency="usd"):
+    """Total due, in the currency's minor units."""
+    try:
+        total = sum(line_total(line) for line in lines)
+        return int(total * 100)
+    except Exception:
+        log.warning("could not compute total for %s invoice", currency)
+        return 0
diff --git a/tests/test_currency.py b/tests/test_currency.py
new file mode 100644
index 0000000..084f850
--- /dev/null
+++ b/tests/test_currency.py
@@ -0,0 +1,36 @@
+import unittest
+
+from invoicing.currency import CachedRates, StaticRates, convert, format_amount
+
+
+class CountingRates(StaticRates):
+    def __init__(self, rates):
+        super().__init__(rates)
+        self.calls = 0
+
+    def get_rate(self, from_ccy, to_ccy):
+        self.calls += 1
+        return super().get_rate(from_ccy, to_ccy)
+
+
+class CurrencyTest(unittest.TestCase):
+    def test_format_usd(self):
+        self.assertEqual(format_amount(2099, "usd"), "20.99 USD")
+
+    def test_convert_same_currency(self):
+        self.assertEqual(convert(1234, "eur", "eur", None), 1234)
+
+    def test_convert_eur_to_usd(self):
+        rates = StaticRates({"eur:usd": "1.09"})
+        self.assertEqual(convert(1000, "eur", "usd", rates), 1090)
+
+    def test_cached_rates_call_provider_once(self):
+        provider = CountingRates({"eur:usd": "1.09"})
+        rates = CachedRates(provider)
+        for _ in range(5):
+            rates.get_rate("eur", "usd")
+        self.assertEqual(provider.calls, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
